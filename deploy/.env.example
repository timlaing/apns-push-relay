# Copy to .env (next to docker-compose.yml) and fill in. Compose reads .env
# automatically for ${VAR} interpolation; .env is gitignored — never commit it.
# Generate secrets with:  openssl rand -base64 48

# Admin API token (>= 32 chars) — the relay refuses to start without it.
RELAY_ADMIN_TOKEN=
# Master secret for keys-at-rest encryption.
RELAY_MASTER_SECRET=
# Let's Encrypt registration address — certbot sends expiry notices here.
LETSENCRYPT_EMAIL=
# Public API domain (A record → this VPS).
API_DOMAIN=api.push.example.org

# Edge HTTPS policy. 1 (default): port 80 always redirects to HTTPS. Set 0
# when this stack runs behind a TLS-terminating proxy that sets
# X-Forwarded-Proto — port 80 then serves such requests instead of
# redirecting them. Leave at 1 on a public edge: clients could otherwise
# spoof the header and skip the upgrade.
FORCE_HTTPS=1
