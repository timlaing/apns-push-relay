# Rendered by the nginx image's envsubst helper at container start (invoked
# from nginx-entrypoint.sh, since the compose `command` bypasses the default
# entrypoint). envsubst substitutes ONLY variables defined in the container
# environment (${API_DOMAIN}, ${FORCE_HTTPS}); nginx runtime
# variables such as $host, $request_uri and $binary_remote_addr survive
# untouched.
#
# /admin is deliberately never proxied — the admin API has its own
# listener (port 8000, host loopback only; PLAN §3), and the public
# listener on 8001 serves no /admin routes at all. /docs, /redoc and
# /openapi.json ARE proxied, but the relay serves them only when config
# sets server.swagger_ui: true (404 otherwise).

limit_req_zone $binary_remote_addr zone=relaylimit:10m rate=30r/s;

# Port 80 upgrades to HTTPS. ${FORCE_HTTPS} (compose default 1) keeps that
# unconditional; set it to 0 when this nginx sits behind a TLS-terminating
# proxy — requests carrying X-Forwarded-Proto: https are then served here
# instead of redirected. Deliberately opt-in: at the default any client
# could spoof the header and skip the upgrade.
map $http_x_forwarded_proto $force_https {
    default 1;
    https   ${FORCE_HTTPS};
}

# Per-IP rate limiting keys on the LAST X-Forwarded-For entry, so this edge
# is the hop that must name the true client. ${FORCE_HTTPS}=1 (direct
# clients): append our hop as usual. ${FORCE_HTTPS}=0 (behind a
# TLS-terminating proxy): pass the outer proxy's list through untouched — it
# already appended the client address, and appending again would collapse
# every client onto the proxy's address. The outer proxy must overwrite or
# append the real client address; plain pass-through of a client-supplied
# header would let callers pick their own limit key.
map "${FORCE_HTTPS}" $xff_value {
    0       $http_x_forwarded_for;
    default $proxy_add_x_forwarded_for;
}

server {
    listen 80;
    server_name _;
    server_tokens off;

    # Same 16k cap as port 443: in behind-proxy mode (FORCE_HTTPS=0) this
    # port carries the real traffic, so the limit must not live on 443
    # alone.
    client_max_body_size 16k;

    # ACME webroot challenge for certbot.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Internal-only route, blocked on port 80 too: in behind-proxy mode this
    # block proxies, and /admin must never be forwarded to the relay.
    location /admin { return 404; }

    # Default: upgrade to HTTPS. Behind a TLS-terminating proxy
    # (FORCE_HTTPS=0) requests whose X-Forwarded-Proto is https are served
    # instead — the `if` carries only `return` (the safe nginx pattern);
    # proxying happens when it does not fire.
    location / {
        if ($force_https) {
            return 301 https://${API_DOMAIN}$request_uri;
        }
        limit_req zone=relaylimit burst=60 nodelay;
        proxy_pass http://relay:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $xff_value;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}

server {
    listen 443 ssl;
    http2 on; # nginx >= 1.25.1 syntax; `listen ... http2` is deprecated
    server_name ${API_DOMAIN};
    server_tokens off;

    # Served from /etc/nginx/certs — a self-signed placeholder until certbot
    # issues, then a symlink to the Let's Encrypt files (nginx-entrypoint.sh;
    # the certbot-conf volume itself is mounted read-only here).
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    client_max_body_size 16k;

    # Internal-only route: 404 at the public edge; use
    # `docker compose exec relay relay …` instead.
    location /admin { return 404; }

    # Interactive API docs (Swagger UI / ReDoc / schema). The relay serves
    # these only when config.yaml sets server.swagger_ui: true, otherwise it
    # 404s them — the edge behaviour is unchanged for instances that do not
    # opt in.
    location /docs {
        limit_req zone=relaylimit burst=60 nodelay;
        proxy_pass http://relay:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $xff_value;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /redoc {
        limit_req zone=relaylimit burst=60 nodelay;
        proxy_pass http://relay:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $xff_value;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /openapi.json {
        limit_req zone=relaylimit burst=60 nodelay;
        proxy_pass http://relay:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $xff_value;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The relay trusts X-Forwarded-For for per-IP rate limiting because it is
    # never exposed beyond this proxy.
    location /v1/ {
        limit_req zone=relaylimit burst=60 nodelay;
        proxy_pass http://relay:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $xff_value;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass http://relay:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $xff_value;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /metrics {
        proxy_pass http://relay:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $xff_value;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API root proxies to the relay, which answers with a JSON pointer to
    # the docs site (landing lives on GitHub Pages; the docs host is an
    # env on the relay image, never rendered here).
    location / {
        proxy_pass http://relay:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $xff_value;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
