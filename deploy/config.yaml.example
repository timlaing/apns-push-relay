# Example instance configuration — copy to ./config.yaml (next to
# docker-compose.yml) and edit. Loaded at /etc/apns-relay/config.yaml in the
# container; the loader (src/apns_relay/config.py) rejects unknown keys, so
# this file must match its schema exactly.
#
# Relative paths (grant_issuer_key, …) resolve against the directory
# holding this file — /etc/apns-relay/ in the container, ./ on the host.
# App key files are always looked up at keys/AuthKey_<key_id>.p8 here too.

server:
  api_domain: api.push.example.org # THIS instance's API domain — set by the
  # operator; no hostname is hardcoded
  docs_domain: push.example.org # docs host (project URL until a CNAME exists)
  public_scheme: https
  swagger_ui: false # true → Swagger UI at /docs, ReDoc at /redoc and the
  # schema at /openapi.json on the API domain (off by default; /admin is
  # never exposed either way)

enrollment:
  # Ed25519 key that signs grants and challenges:
  #   mkdir -p keys && openssl genpkey -algorithm ed25519 -out keys/issuer.pem
  grant_issuer_key: keys/issuer.pem
  challenge_ttl: 600 # seconds; bounds 60..3600
  # App Attest root: Apple publishes ONE root CA for App Attest (development
  # and production attestations chain to it; AAGUIDs separate the
  # environments). The container downloads it at startup from this public URL
  # and verifies it against a pinned SHA-256; `relay doctor --fetch-roots`
  # re-downloads. Set to null to manage the file(s) yourself.
  attest_root_url: https://www.apple.com/certificateauthority/Apple_App_Attestation_Root_CA.pem
  # Where the root lands / which file each environment verifies. Until the
  # root for an App's attest_environment resolves, enroll/finish fails closed
  # with 400 attestation_unavailable.
  attest_root_certs:
    development: /var/lib/apns-relay/apple-attest-root.pem
    production: /var/lib/apns-relay/apple-attest-root.pem

storage:
  database: /var/lib/apns-relay/relay.db # SQLite WAL — the only backup target

apps:
  # One entry per APNs app key. `key_id` is the 10-char id from Apple's
  # AuthKey_<KEYID>.p8 filename; the key file is looked up at
  # keys/AuthKey_<key_id>.p8. The APNs topic is the bundle_id.
  - id: my-app
    display_name: My App # shown in enrollment consent receipts
    bundle_id: com.example.myapp # bundle identifier only (no App ID prefix)
    team_id: XXXXXXXXXX # Apple Team ID, from the developer account
    key_id: XXXXXXXXXX # 10-char APNs key id (AuthKey_XXXXXXXXXX.p8)
    environments: [sandbox, production]
    kinds: [alert, background, liveActivity]
    live_activity: true
    attest_environment: production # App Attest: development | production
    registration:
      callback_required: false # per key — strictness is an App-level policy
    caps: { title: 64, subtitle: 64, body: 200, sealed: 1024, category: 32, background: 512 }
    quota:
      # per key — every App states its own; no global default
      burst_per_min: 10
      daily: 5000
      token_burst_per_min: 20
    grant_ttl: { min: 900, max: 86400, default: 21600 } # seconds; tenants pick within
